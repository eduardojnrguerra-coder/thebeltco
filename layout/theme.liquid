<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="theme-color" content="{{ settings.color_primary }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="//cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="//shop.app" crossorigin>
    <link rel="dns-prefetch" href="//productreviews.shopifycdn.com">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- liquid
      assign seo_title = page_title | default: settings.meta_title
      assign seo_description = page_description | default: settings.meta_description

      if template.name == 'index'
        assign seo_title = 'Leather Belts South Africa | Genuine Leather & Ratchet Belts | TheBeltCo'
        assign seo_description = 'Shop durable leather belts in South Africa from TheBeltCo. Genuine leather, everyday styles, ratchet belts, easy sizing, and free delivery on orders of R700 or more.'
      elsif template.name == 'collection' and collection != blank and collection.handle == 'belts'
        assign default_collection_description = collection.description | strip_html | truncate: 320
        assign seo_title = "Leather Belts South Africa | Men's Genuine Leather Belts | TheBeltCo"
        if seo_description == blank or seo_description == settings.meta_description or seo_description == default_collection_description
          assign seo_description = 'Browse TheBeltCo leather belts for everyday wear, work, smart casual outfits, and gifting. Durable styles, clear sizing, and delivery across South Africa.'
        endif
      elsif template.name == 'product' and product != blank
        assign product_title_with_shop = product.title | append: ' - ' | append: shop.name
        assign product_title_with_pipe = product.title | append: ' | ' | append: shop.name
        if seo_title == blank or seo_title == product.title or seo_title == product_title_with_shop or seo_title == product_title_with_pipe
          assign seo_title = product.title | append: ' | Leather Belt South Africa | TheBeltCo'
        endif
        if seo_description == blank or seo_description == settings.meta_description
          assign seo_description = 'Shop the ' | append: product.title | append: ' from TheBeltCo. A durable belt for everyday wear with clear sizing, secure checkout, and delivery across South Africa.'
        endif
      endif
    -%}

    <title>{{ seo_title | escape }}</title>

    <meta name="description" content="{{ seo_description | strip | escape }}">

    {%- liquid
      assign is_noindex = false
      if template.name == 'cart' or template.name == 'search'
        assign is_noindex = true
      endif
      if template.name == 'customers'
        assign is_noindex = true
      endif
      if template.name == 'collection' and current_tags != blank
        assign is_noindex = true
      endif
      if template.name == 'collection' and collection.sort_by != blank and collection.sort_by != 'manual'
        assign is_noindex = true
      endif
    -%}
    {%- if is_noindex -%}
      <meta name="robots" content="noindex">
    {%- endif -%}

    {% render 'social-meta-tags', seo_title: seo_title, seo_description: seo_description %}

    {{ content_for_header }}

    {{ 'theme.css' | asset_url | stylesheet_tag }}

    {%- liquid
      assign heading_font_family = 'Georgia, "Times New Roman", serif'
      if settings.heading_font == 'times'
        assign heading_font_family = '"Times New Roman", Georgia, serif'
      elsif settings.heading_font == 'playfair'
        assign heading_font_family = '"Playfair Display", Georgia, serif'
      elsif settings.heading_font == 'lora'
        assign heading_font_family = 'Lora, Georgia, serif'
      endif

      assign body_font_family = '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif'
      if settings.body_font == 'inter'
        assign body_font_family = 'Inter, -apple-system, sans-serif'
      elsif settings.body_font == 'roboto'
        assign body_font_family = 'Roboto, -apple-system, sans-serif'
      elsif settings.body_font == 'lato'
        assign body_font_family = 'Lato, -apple-system, sans-serif'
      endif
    -%}

    <style>
      :root {
        --color-primary: {{ settings.color_primary }};
        --color-primary-dark: {{ settings.color_primary_dark }};
        --color-secondary: {{ settings.color_secondary }};
        --color-accent: {{ settings.color_accent }};
        --color-bg: {{ settings.color_bg }};
        --color-bg-alt: {{ settings.color_bg_alt }};
        --color-text: {{ settings.color_text }};
        --color-text-light: {{ settings.color_text_light }};
        --color-border: {{ settings.color_border }};
        --color-success: {{ settings.color_success }};
        --color-error: {{ settings.color_error }};
        --color-sale: {{ settings.color_sale }};
        --color-button-text: {{ settings.color_button_text }};
        --font-heading-family: {{ heading_font_family }};
        --font-body-family: {{ body_font_family }};
        --font-body-size: {{ settings.base_font_size }}px;
        --font-heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
        --page-width: 1280px;
        --page-gutter: 1.5rem;
      }
    </style>

    {% render 'structured-data-organization' %}
    {% render 'structured-data-product' %}
    {% render 'structured-data-breadcrumbs' %}

    {%- if template.name == 'article' and article != blank -%}
      {%- liquid
        assign article_desc = article.excerpt_or_content | strip_html | truncate: 300
      -%}
      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": {{ article.title | json }},
        "url": {{ canonical_url | json }},
        "image": {{ article.image | image_url: width: 1200 | json }},
        "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
        "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
        "author": {
          "@type": "Person",
          "name": {{ article.author | json }}
        },
        "publisher": {
          "@type": "Organization",
          "name": {{ shop.name | json }}
        },
        "description": {{ article_desc | json }}
      }
      </script>
    {%- endif -%}

    {%- if template.name == 'collection' and collection != blank -%}
      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        "name": {{ collection.title | json }},
        "url": {{ canonical_url | json }},
        "description": {{ collection.description | strip_html | truncate: 500 | json }}
      }
      </script>
    {%- endif -%}

    {%- if template.name == 'blog' and blog != blank -%}
      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Blog",
        "name": {{ blog.title | json }},
        "url": {{ canonical_url | json }},
        "description": {{ blog.metafields.custom.description | default: blog.title | json }}
      }
      </script>
    {%- endif -%}

    {%- if template.name == 'page' and page != blank -%}
      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "name": {{ page.title | json }},
        "url": {{ canonical_url | json }}
      }
      </script>
    {%- endif -%}

    {%- if template.name == 'index' -%}
      {%- liquid
        assign website_url = shop.url | default: request.origin
        assign search_target = website_url | append: routes.search_url | append: '?q={search_term_string}'
      -%}
      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": {{ shop.name | json }},
        "url": {{ website_url | json }},
        "potentialAction": {
          "@type": "SearchAction",
          "target": {{ search_target | json }},
          "query-input": "required name=search_term_string"
        }
      }
      </script>
    {%- endif -%}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    </script>
  </head>

  <body class="template-{{ template.name | handle }}{% if template.suffix %} template-{{ template.name | handle }}-{{ template.suffix }}{% endif %}">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {%- if settings.show_announcement -%}
      {% section 'announcement-bar' %}
    {%- endif -%}
    {% section 'header' %}

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    <div class="overlay" id="overlay"></div>

    {%- if settings.enable_cart_drawer -%}
      {% render 'cart-drawer' %}
    {%- endif -%}

    <script src="{{ 'theme.js' | asset_url }}" defer></script>

    <script>
      window.thebeltco = {
        routes: {
          cart: '{{ routes.cart_url }}',
          cartAdd: '{{ routes.cart_add_url }}',
          cartChange: '{{ routes.cart_change_url }}',
          cartClear: '{{ routes.cart_clear_url }}',
          predictiveSearch: '{{ routes.predictive_search_url }}'
        },
        settings: {
          cartDrawer: {{ settings.enable_cart_drawer | json }}
        },
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }},
          itemAdded: {{ 'products.product.item_added' | t | json }},
          cartError: {{ 'cart.general.error' | t | json }}
        }
      };
    </script>
    <!-- TheBeltCo WhatsApp Button -->
<a 
  href="https://wa.me/27638035628?text=Hi%20TheBeltCo%2C%20I%20need%20help%20with%20a%20belt%20order."
  class="thebeltco-whatsapp-button"
  target="_blank"
  rel="noopener"
  aria-label="Chat with TheBeltCo on WhatsApp"
>
  WhatsApp Us
</a>

<style>
  .thebeltco-whatsapp-button {
    position: fixed;
    right: 18px;
    bottom: 18px;
    z-index: 9999;
    background: #25D366;
    color: #ffffff;
    padding: 14px 20px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(0,0,0,0.25);
    letter-spacing: 0.2px;
  }

  .thebeltco-whatsapp-button:hover {
    background: #1ebe5d;
    color: #ffffff;
  }

  @media screen and (max-width: 749px) {
    .thebeltco-whatsapp-button {
      right: 14px;
      bottom: 14px;
      padding: 13px 18px;
      font-size: 14px;
    }

    body.template-product .thebeltco-whatsapp-button,
    body.template-cart .thebeltco-whatsapp-button {
      bottom: 86px;
    }
  }
</style>
  </body>
</html>
