{%- capture testimonials_markup -%}
  {%- for block in section.blocks -%}
    {%- assign testimonial_text = block.settings.text | strip -%}
    {%- assign testimonial_author = block.settings.author | strip -%}
    {%- if testimonial_text != blank and testimonial_author != blank -%}
      <div class="testimonials__item" {{ block.shopify_attributes }}>
        {% render 'review-card',
          text: block.settings.text,
          author: block.settings.author,
          rating: block.settings.rating
        %}
      </div>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign testimonials_markup_stripped = testimonials_markup | strip -%}

{%- if testimonials_markup_stripped != blank -%}
<section class="testimonials">
  <div class="page-width">
    <div class="section-header">
      <h2 class="section-header__title">{{ section.settings.heading }}</h2>
    </div>

    <div class="testimonials__grid">
      {{ testimonials_markup }}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "section section--testimonials",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Customers Choose TheBeltCo"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Testimonial text",
          "default": ""
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author name",
          "default": ""
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials"
    }
  ]
}
{% endschema %}
