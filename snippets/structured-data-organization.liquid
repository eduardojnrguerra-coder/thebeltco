{%- liquid
  assign shop_name = shop.name
  assign shop_url = shop.url | default: request.origin
  assign description = shop.description | default: settings.meta_description
  assign facebook_url = settings.social_facebook | default: settings.social_facebook_link
  assign instagram_url = settings.social_instagram | default: settings.social_instagram_link
  assign tiktok_url = settings.social_tiktok | default: settings.social_tiktok_link
  assign youtube_url = settings.social_youtube_link

  assign has_logo = false
  if settings.logo != blank
    assign has_logo = true
    assign logo_url = settings.logo | image_url: width: 600
  endif

  assign has_social = false
  if facebook_url != blank or instagram_url != blank or tiktok_url != blank or youtube_url != blank
    assign has_social = true
  endif

  assign has_contact = false
  if settings.contact_email != blank or settings.contact_phone != blank
    assign has_contact = true
  endif
-%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ shop_name | json }},
  "url": {{ shop_url | json }},
  "description": {{ description | json }}{% if has_logo %},
  "logo": {{ logo_url | json }}{% endif %}{% if has_social %},
  "sameAs": [
    {%- if facebook_url != blank %}{{ facebook_url | json }}{% endif %}
    {%- if instagram_url != blank %}{% if facebook_url != blank %},{% endif %}{{ instagram_url | json }}{% endif %}
    {%- if tiktok_url != blank %}{% if facebook_url != blank or instagram_url != blank %},{% endif %}{{ tiktok_url | json }}{% endif %}
    {%- if youtube_url != blank %}{% if facebook_url != blank or instagram_url != blank or tiktok_url != blank %},{% endif %}{{ youtube_url | json }}{% endif %}
  ]
  {%- endif -%}
  {%- if has_contact %},
  "contactPoint": [
    {
      "@type": "ContactPoint",
      "telephone": {{ settings.contact_phone | default: '' | json }},
      "email": {{ settings.contact_email | default: '' | json }},
      "contactType": "customer service"
    }
  ]
  {%- endif -%}
}
</script>
